{
  "expo": {
    "name": "SatvikScan",
    "slug": "satvikscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.satvicscan.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SatvikScan needs camera access to scan ingredient labels and barcodes.",
        "NSMicrophoneUsageDescription": "SatvikScan does not use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "SatvikScan needs camera access to scan ingredient labels and barcodes."
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "satvikscan"
  }
}
